# ========================================================
# AnimDiar-Sync 環境設定範本 (.env.example)
# 請複製此檔案為 .env 並填入您自己的金鑰與設定：
# cp .env.example .env
# ========================================================

# Hugging Face Access Token for Pyannote Speaker Diarization
# 取得方式：至 https://huggingface.co/settings/tokens 建立具備 Read 權限的 Token
# 並確認已於 Hugging Face 頁面接受 pyannote/speaker-diarization-3.1 與 pyannote/segmentation-3.0 使用協議
HF_TOKEN=your_huggingface_token_here

# Local LLM Configuration (Ollama)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=cwchang/llama3-taide-lx-8b-chat-alpha1

# Faster-Whisper Model Default (可選: tiny, base, small, medium, large-v3)
WHISPER_MODEL=medium

